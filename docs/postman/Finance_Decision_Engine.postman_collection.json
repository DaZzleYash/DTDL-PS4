            "url": "{{baseUrl}}/api/decisions/evaluate",
            "description": "Expected final_decision: APPROVE. Matches Minimum Credit Score (priority 10).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"applicant\": {\n      \"creditScore\": 720,\n      \"annualIncome\": 85000,\n      \"employmentStatus\": \"EMPLOYED\",\n      \"dateOfBirth\": \"1996-07-25\",\n      \"existingCustomer\": false\n    },\n    \"loan\": {\n      \"amount\": 25000,\n      \"purpose\": \"AUTO\",\n      \"termMonths\": 60\n    },\n    \"risk_flags\": {\n      \"hasDefaulted\": false,\n      \"debtToIncomeRatio\": 0.3\n    }\n  },\n  \"category\": null\n}",
