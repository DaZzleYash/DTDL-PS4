# Database connection — SQLite for local dev, Postgres for Docker
DATABASE_URL=sqlite:///./data/decisions.db

# Logging
LOG_LEVEL=INFO

# Environment tag (local | docker | staging | production)
APP_ENV=local

# Comma-separated browser origins allowed to call the API (production: add your Vercel URL)
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Or use * for hackathon demos (disables credential cookies)
# CORS_ORIGINS=*
